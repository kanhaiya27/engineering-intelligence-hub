{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "S=\"$CLAUDE_PROJECT_DIR/scripts/git_sync_guard.py\"; if [ -f \"$S\" ]; then \"$CLAUDE_PROJECT_DIR/.venv311/Scripts/python.exe\" \"$S\" session; fi",
            "timeout": 45,
            "statusMessage": "Checking GitHub for the other laptop's changes..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "S=\"$CLAUDE_PROJECT_DIR/scripts/git_sync_guard.py\"; if [ -f \"$S\" ]; then \"$CLAUDE_PROJECT_DIR/.venv311/Scripts/python.exe\" \"$S\" pretool; fi",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
