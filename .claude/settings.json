{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv311/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/scripts/git_sync_guard.py\" session",
            "timeout": 45,
            "statusMessage": "Checking GitHub for the other laptop's changes..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv311/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/scripts/git_sync_guard.py\" pretool",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
