# ============================================================
# Engineering Intelligence Hub — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git (it is in .gitignore).
# ============================================================

# --- LLM Provider API Keys ---
# Leave empty if using local models only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TOGETHER_API_KEY=
HF_TOKEN=

# --- Local Model (Ollama / vLLM) ---
EIH_LOCAL_MODEL_BASE_URL=http://localhost:11434

# --- API Settings ---
EIH_API_PORT=8000
EIH_API_RELOAD=true       # Set to false in production

# --- Logging ---
EIH_LOG_LEVEL=INFO
EIH_JSON_LOGS=false        # Set true for containerised deployments

# --- Runtime Environment ---
EIH_ENVIRONMENT=development   # development | testing | production

# --- Vector Store ---
EIH_VECTOR_PROVIDER=qdrant
EIH_VECTOR_HOST=localhost
EIH_VECTOR_PORT=6333
EIH_VECTOR_COLLECTION_NAME=eih_knowledge

# --- Graph Store ---
EIH_GRAPH_URI=bolt://localhost:7687
EIH_GRAPH_USERNAME=neo4j
EIH_GRAPH_PASSWORD=

# --- Quality Gate ---
EIH_QUALITY_DEFAULT_QUALITY_THRESHOLD=0.75
EIH_QUALITY_MAX_ESCALATION_ATTEMPTS=2

# --- Sustainability ---
# Carbon intensity for your inference region in gCO2e/kWh
# UK 2024 national grid average: 233.0
# Update per experiment run location.
EIH_SUSTAINABILITY_CARBON_INTENSITY_GCO2_PER_KWH=233.0
