# ============================================================
# Engineering Intelligence Hub — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git (it is in .gitignore).
# ============================================================

# --- LLM Provider API Keys ---
# Leave empty if using local models only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TOGETHER_API_KEY=
HF_TOKEN=

# --- Local Model (Ollama / vLLM) ---
EIH_LOCAL_MODEL_BASE_URL=http://localhost:11434

# --- API Settings ---
EIH_API_PORT=8000
EIH_API_RELOAD=true       # Set to false in production

# --- Logging ---
EIH_LOG_LEVEL=INFO
EIH_JSON_LOGS=false        # Set true for containerised deployments

# --- Machine identity (recorded with every result; see docs/WORKFLOW.md) ---
# laptop-a = RTX 4050 laptop, laptop-b = RTX 5050 laptop
EIH_MACHINE_ID=laptop-a

# --- Runtime Environment ---
EIH_ENVIRONMENT=development   # development | testing | production

# --- Vector Store ---
EIH_VECTOR_PROVIDER=qdrant
EIH_VECTOR_HOST=localhost
EIH_VECTOR_PORT=6333
EIH_VECTOR_COLLECTION_NAME=eih_knowledge

# --- Graph Store ---
EIH_GRAPH_URI=bolt://localhost:7687
EIH_GRAPH_USERNAME=neo4j
EIH_GRAPH_PASSWORD=

# --- Quality Gate ---
EIH_QUALITY_DEFAULT_QUALITY_THRESHOLD=0.75
EIH_QUALITY_MAX_ESCALATION_ATTEMPTS=3

# --- Retrieval / Reranking ---
EIH_RETRIEVAL_RERANKER_MODEL_ID=cross-encoder/ms-marco-MiniLM-L-6-v2
# Set true for FINAL experiment runs: a strategy that requests reranking but
# cannot run it will then raise instead of silently returning unreranked results.
EIH_RETRIEVAL_STRICT_RERANKING=false

# --- Sustainability ---
# Grid carbon intensity for the region where inference ACTUALLY runs.
# Named regions: uk_national_grid_2024 (233), eu_average_2023 (251),
#   us_average_2023 (386), india_average_2023 (713), france_2023 (56),
#   germany_2023 (385), renewable_100pct (0)
# Use "custom" to supply an explicit value below.
#
# Carbon intensity varies >10x between grids, so CO2e reported without stating
# the region is not a defensible result. Disclose this value in the paper.
EIH_SUSTAINABILITY_CARBON_REGION=custom
EIH_SUSTAINABILITY_CARBON_INTENSITY_GCO2_PER_KWH=713.0

# Hardware TDP used for energy estimation when direct power reads are unavailable.
# Defaults match the dev laptop (i7-12650H / RTX 4050). CHANGE THESE if you run
# the experiments on different hardware, or the energy figures will be wrong.
EIH_SUSTAINABILITY_CPU_TDP_WATTS=45.0
EIH_SUSTAINABILITY_GPU_TDP_WATTS=60.0
